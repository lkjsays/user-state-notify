<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kjlee.user-state-session-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.user-state-notify/scripts/watch_macos_session.sh</string>
    <string>--server-url</string>
    <string>__SERVER_URL__</string>
  </array>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.hermes/logs/session_watch.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.hermes/logs/session_watch.err.log</string>
</dict>
</plist>
