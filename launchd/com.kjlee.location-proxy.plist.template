<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kjlee.location-proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/.hermes/scripts/location_proxy.py</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.hermes/logs/user_state_notify_proxy.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.hermes/logs/user_state_notify_proxy.launchd.err.log</string>
</dict>
</plist>
