<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kjlee.user-state-login-notify</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.user-state-notify/scripts/notify_login.sh</string>
    <string>--server-url</string>
    <string>__SERVER_URL__</string>
    <string>--event-path</string>
    <string>/device/login</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.hermes/logs/user_state_login_notify.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.hermes/logs/user_state_login_notify.err.log</string>
</dict>
</plist>
